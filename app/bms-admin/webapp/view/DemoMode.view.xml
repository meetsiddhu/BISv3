<mvc:View
  controllerName="BridgeManagement.bmsadmin.controller.DemoMode"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:f="sap.ui.layout.form"
  xmlns:core="sap.ui.core"
  displayBlock="true">

  <Page id="demoModePage" showHeader="true">

    <customHeader>
      <Bar>
        <contentLeft>
          <Title text="{i18n>demo.title}" level="H3" />
        </contentLeft>
        <contentRight>
          <Button icon="sap-icon://refresh" tooltip="{i18n>demo.refreshStatus}" press=".onRefresh" type="Transparent" />
        </contentRight>
      </Bar>
    </customHeader>

    <content>
      <VBox class="sapUiMediumMargin">

        <!-- Status Banner -->
        <MessageStrip
          id="demoStatusStrip"
          text="{demo>/statusText}"
          type="{demo>/statusType}"
          showIcon="true"
          class="sapUiSmallMarginBottom" />

        <!-- What is Demo Mode -->
        <Panel headerText="{i18n>demo.aboutTitle}" expandable="true" expanded="true" class="sapUiSmallMarginBottom">
          <VBox class="sapUiSmallMargin">
            <Text wrapping="true" class="sapUiSmallMarginBottom"
              text="{i18n>demo.about1}" />
            <Text wrapping="true" class="sapUiSmallMarginBottom"
              text="{i18n>demo.about2}" />
            <MessageStrip
              text="{i18n>demo.warning}"
              type="Warning" showIcon="true" showCloseButton="false" />
          </VBox>
        </Panel>

        <!-- Demo Dataset Summary -->
        <Panel headerText="{i18n>demo.datasetTitle}" expandable="true" expanded="true" class="sapUiSmallMarginBottom">
          <VBox class="sapUiSmallMargin">
            <Text text="{i18n>demo.datasetIntro}" wrapping="true" class="sapUiSmallMarginBottom" />
            <f:SimpleForm layout="ColumnLayout" columnsM="2" columnsL="3" editable="false">
              <f:content>
                <Label text="{i18n>demo.region.sydney}" />       <Text text="{i18n>demo.region.sydney.bridges}" />
                <Label text="{i18n>demo.region.hunter}" />             <Text text="{i18n>demo.region.hunter.bridges}" />
                <Label text="{i18n>demo.region.northern}" />       <Text text="{i18n>demo.region.northern.bridges}" />
                <Label text="{i18n>demo.region.newEngland}" />  <Text text="{i18n>demo.region.newEngland.bridges}" />
                <Label text="{i18n>demo.region.southern}" />   <Text text="{i18n>demo.region.southern.bridges}" />
                <Label text="{i18n>demo.region.farWest}" />        <Text text="{i18n>demo.region.farWest.bridges}" />
                <Label text="{i18n>demo.region.centralWest}" />       <Text text="{i18n>demo.region.centralWest.bridges}" />
              </f:content>
            </f:SimpleForm>
            <HBox class="sapUiSmallMarginTop" wrap="Wrap">
              <ObjectStatus text="{i18n>demo.legend.poor}" state="Error"   class="sapUiTinyMarginEnd sapUiSmallMarginBottom" />
              <ObjectStatus text="{i18n>demo.legend.restricted}"           state="Warning" class="sapUiTinyMarginEnd sapUiSmallMarginBottom" />
              <ObjectStatus text="{i18n>demo.legend.good}" state="Success" class="sapUiTinyMarginEnd sapUiSmallMarginBottom" />
              <ObjectStatus text="{i18n>demo.legend.heritage}"       state="None"    class="sapUiTinyMarginEnd sapUiSmallMarginBottom" />
            </HBox>
          </VBox>
        </Panel>

        <!-- Controls -->
        <Panel headerText="{i18n>demo.controlsTitle}" expandable="false" class="sapUiSmallMarginBottom">
          <VBox class="sapUiSmallMargin">
            <HBox wrap="Wrap" class="sapUiSmallMarginBottom">
              <VBox class="sapUiMediumMarginEnd" width="18rem">
                <Title text="{i18n>demo.loadTitle}" level="H5" />
                <Text wrapping="true" class="sapUiTinyMarginTop sapUiSmallMarginBottom"
                  text="{i18n>demo.loadText}" />
                <Button
                  id="btnLoadDemo"
                  text="{i18n>demo.loadButton}"
                  icon="sap-icon://begin"
                  type="Emphasized"
                  press=".onLoadDemoData"
                  enabled="{= !${demo>/demoActive} }" />
              </VBox>
              <VBox width="18rem">
                <Title text="{i18n>demo.clearTitle}" level="H5" />
                <Text wrapping="true" class="sapUiTinyMarginTop sapUiSmallMarginBottom"
                  text="{i18n>demo.clearText}" />
                <Button
                  id="btnClearDemo"
                  text="{i18n>demo.clearButton}"
                  icon="sap-icon://clear-all"
                  type="Reject"
                  press=".onClearDemoData"
                  enabled="{demo>/demoActive}" />
              </VBox>
            </HBox>
            <Text text="{i18n>demo.controlsNote}" class="sapUiTinyText sapThemePositive" />
          </VBox>
        </Panel>

        <!-- Current bridge count -->
        <Panel headerText="{i18n>demo.systemStateTitle}" expandable="true" expanded="true" class="sapUiSmallMarginBottom">
          <f:SimpleForm layout="ColumnLayout" columnsM="1" columnsL="2" editable="false">
            <f:content>
              <Label text="{i18n>demo.totalBridges}" />
              <ObjectStatus text="{demo>/bridgeCount}" state="{= ${demo>/bridgeCount} > 0 ? 'Success' : 'None' }" />
              <Label text="{i18n>demo.statusLabel}" />
              <ObjectStatus text="{demo>/statusLabel}" state="{demo>/statusState}" />
              <Label text="{i18n>demo.dataSource}" />
              <Text text="{demo>/dataSource}" />
            </f:content>
          </f:SimpleForm>
        </Panel>

      </VBox>
    </content>

  </Page>

</mvc:View>
