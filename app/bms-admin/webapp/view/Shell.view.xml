<mvc:View
  controllerName="BridgeManagement.bmsadmin.controller.Shell"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:tnt="sap.tnt"
  displayBlock="true">

  <tnt:ToolPage id="toolPage" sideExpanded="true">

    <tnt:header>
      <tnt:ToolHeader>
        <Button icon="sap-icon://menu2" type="Transparent" press=".onToggleSideNav" tooltip="{i18n>shell.toggleNav}" />
        <Title text="{i18n>shell.admin.title}" titleStyle="H4" class="sapUiSmallMarginBegin" />
        <ToolbarSpacer />
      </tnt:ToolHeader>
    </tnt:header>

    <tnt:sideContent>
      <tnt:SideNavigation id="sideNav" itemSelect=".onNavSelect">
        <tnt:item>
          <tnt:NavigationList id="navList">
            <tnt:NavigationListItem text="{i18n>shell.nav.systemConfig}"     key="systemConfig"    icon="sap-icon://settings"      />
            <tnt:NavigationListItem text="{i18n>shell.nav.bnacConfig}"       key="bnacConfig"      icon="sap-icon://chain-link"    />
            <tnt:NavigationListItem text="{i18n>shell.nav.gisConfig}"        key="gisConfig"       icon="sap-icon://map"           />
            <tnt:NavigationListItem text="{i18n>risk.nav.riskModel}"    key="riskModel"       icon="sap-icon://measurement-document" />
            <tnt:NavigationListItem text="{i18n>nav.assetStrategy}" key="assetStrategy" icon="sap-icon://example"     />
            <tnt:NavigationListItem text="{i18n>nav.prioModels}" key="prioritisationModels" icon="sap-icon://sort-descending" />
            <tnt:NavigationListItem text="{i18n>shell.nav.bhiConfig}"   key="bhiConfig"       icon="sap-icon://building"      />
            <tnt:NavigationListItem text="{i18n>shell.nav.demoMode}"         key="demoMode"        icon="sap-icon://simulate"      />
          </tnt:NavigationList>
        </tnt:item>
      </tnt:SideNavigation>
    </tnt:sideContent>

    <tnt:mainContents>
      <NavContainer id="adminNavContainer" height="100%" />
    </tnt:mainContents>

  </tnt:ToolPage>

</mvc:View>
