<mvc:View
  controllerName="BridgeManagement.bmsadmin.controller.BnacConfig"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:core="sap.ui.core"
  displayBlock="true">

  <Page id="bnacConfigPage" showHeader="true" class="sapUiContentPadding">

    <customHeader>
      <Bar>
        <contentLeft>
          <Title text="{i18n>bnac.pageTitle}" level="H3" />
        </contentLeft>
        <contentRight>
          <Button icon="sap-icon://refresh" text="{i18n>bnac.refresh}" press=".onRefreshEnvs" type="Transparent" />
          <Button icon="sap-icon://add" text="{i18n>bnac.addEnvironment}" press=".onAddEnv" type="Emphasized" class="sapUiSmallMarginBegin" />
          <Button icon="sap-icon://information" tooltip="{i18n>bnac.help}" press=".onShowHelp" type="Transparent" class="sapUiSmallMarginBegin" />
        </contentRight>
      </Bar>
    </customHeader>

    <content>
      <VBox class="sapUiSmallMargin">

        <Title text="{i18n>bnac.envUrlsTitle}" level="H4" class="sapUiSmallMarginBottom" />
        <Table id="envTable" mode="None" noDataText="{i18n>bnac.noEnvironments}"
               items="{envModel>/environments}" class="sapUiSmallMarginBottom">
          <columns>
            <Column width="120px"><Text text="{i18n>bnac.col.environment}" /></Column>
            <Column width="320px"><Text text="{i18n>bnac.col.baseUrl}" /></Column>
            <Column><Text text="{i18n>bnac.col.description}" /></Column>
            <Column width="80px"  hAlign="Center"><Text text="{i18n>bnac.col.active}" /></Column>
            <Column width="140px"><Text text="{i18n>bnac.col.modifiedBy}" /></Column>
            <Column width="100px" hAlign="Center"><Text text="{i18n>bnac.col.actions}" /></Column>
          </columns>
          <items>
            <ColumnListItem>
              <cells>
                <Text text="{envModel>environment}" />
                <Link text="{envModel>baseUrl}" href="{envModel>baseUrl}" target="_blank" />
                <Text text="{envModel>description}" />
                <CheckBox selected="{envModel>active}" editable="false" />
                <Text text="{envModel>modifiedBy}" />
                <HBox justifyContent="Center">
                  <Button icon="sap-icon://edit"   type="Transparent" press=".onEditEnv"   tooltip="{i18n>bnac.edit}" />
                  <Button icon="sap-icon://delete" type="Transparent" press=".onDeleteEnv" tooltip="{i18n>bnac.delete}" />
                </HBox>
              </cells>
            </ColumnListItem>
          </items>
        </Table>

        <Title text="{i18n>bnac.massLoadTitle}" level="H4" class="sapUiMediumMarginTop sapUiSmallMarginBottom" />
        <MessageStrip text="{i18n>bnac.csvFormat}" type="Information" showCloseButton="false" class="sapUiSmallMarginBottom" />
        <HBox alignItems="Center" class="sapUiSmallMarginBottom">
          <Input id="fileNameDisplay" placeholder="{i18n>bnac.noFileSelected}" width="280px" editable="false" />
          <Button text="{i18n>bnac.browse}" press=".onBrowse" class="sapUiSmallMarginBegin" />
          <Select id="envSelect" width="120px" tooltip="{i18n>bnac.environmentLabel}" class="sapUiSmallMarginBegin">
            <items>
              <core:Item key="DEV"     text="DEV" />
              <core:Item key="PREPROD" text="PREPROD" />
              <core:Item key="PROD"    text="PROD" />
              <core:Item key="TEST"    text="TEST" />
            </items>
          </Select>
          <Button id="uploadBtn" icon="sap-icon://upload" text="{i18n>bnac.uploadBnacIds}" press=".onUpload"
                  type="Emphasized" class="sapUiSmallMarginBegin" enabled="false" />
        </HBox>
        <MessageStrip id="uploadResult" visible="false" showCloseButton="true" class="sapUiSmallMarginBottom" />

        <Title text="{i18n>bnac.loadHistoryTitle}" level="H4" class="sapUiMediumMarginTop sapUiSmallMarginBottom" />
        <Table id="histTable" mode="None" noDataText="{i18n>bnac.noLoadHistory}"
               items="{histModel>/history}">
          <columns>
            <Column width="180px"><Text text="{i18n>bnac.col.loadedAt}" /></Column>
            <Column width="160px"><Text text="{i18n>bnac.col.loadedBy}" /></Column>
            <Column><Text text="{i18n>bnac.col.fileName}" /></Column>
            <Column width="80px"  hAlign="Center"><Text text="{i18n>bnac.col.env}" /></Column>
            <Column width="80px"  hAlign="End"><Text text="{i18n>bnac.col.total}" /></Column>
            <Column width="80px"  hAlign="End"><Text text="{i18n>bnac.col.success}" /></Column>
            <Column width="80px"  hAlign="End"><Text text="{i18n>bnac.col.failed}" /></Column>
          </columns>
          <items>
            <ColumnListItem>
              <cells>
                <Text text="{histModel>loadedAtDisplay}" />
                <Text text="{histModel>loadedBy}" />
                <Text text="{histModel>fileName}" />
                <ObjectStatus text="{histModel>environment}" state="Information" />
                <ObjectNumber number="{histModel>total}"   emphasized="false" />
                <ObjectNumber number="{histModel>success}" state="Success" />
                <ObjectNumber number="{histModel>failed}"  state="{histModel>failedState}" />
              </cells>
            </ColumnListItem>
          </items>
        </Table>

      </VBox>
    </content>
  </Page>

</mvc:View>
