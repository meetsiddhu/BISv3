<mvc:View
  controllerName="BridgeManagement.bmsadmin.controller.GisConfig"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:f="sap.ui.layout.form"
  xmlns:core="sap.ui.core"
  displayBlock="true">

  <Page id="gisConfigPage" showHeader="true">

    <customHeader>
      <Bar>
        <contentLeft>
          <Title text="{i18n>admin.gisConfig.title}" level="H3" />
        </contentLeft>
        <contentRight>
          <Button text="{i18n>gis.save}"    icon="sap-icon://save"    press=".onSave"    type="Emphasized" />
          <Button text="{i18n>gis.discard}" icon="sap-icon://decline"  press=".onDiscard" type="Transparent" class="sapUiSmallMarginBegin" />
          <Button icon="sap-icon://refresh"  tooltip="{i18n>gis.refresh}" press=".onRefresh"   type="Transparent" class="sapUiSmallMarginBegin" />
          <Button icon="sap-icon://information" tooltip="{i18n>gis.help}" press=".onShowHelp" type="Transparent" class="sapUiSmallMarginBegin" />
        </contentRight>
      </Bar>
    </customHeader>

    <content>
      <VBox class="sapUiMediumMargin">

        <!-- Basemap settings -->
        <Panel headerText="{i18n>gis.basemapHeader}" expandable="true" expanded="true" class="sapUiSmallMarginBottom">
          <f:SimpleForm layout="ColumnLayout" columnsM="1" columnsL="2" editable="true">
            <f:content>
              <Label text="{i18n>gis.defaultBasemap}" />
              <Select id="selBasemap" selectedKey="{config>/defaultBasemap}">
                <items>
                  <core:Item key="osm"         text="OpenStreetMap" />
                  <core:Item key="esriStreet"   text="Esri Street" />
                  <core:Item key="esriSatellite" text="Esri Satellite" />
                  <core:Item key="esriTopo"     text="Esri Topo" />
                  <core:Item key="google"       text="Google Maps" />
                  <core:Item key="googleSat"    text="Google Satellite" />
                  <core:Item key="here"         text="HERE Maps" />
                </items>
              </Select>
              <Label text="{i18n>gis.hereApiKey}" />
              <Input id="inpHereApiKey" value="{config>/hereApiKey}" placeholder="{i18n>gis.hereApiKeyPlaceholder}" type="Password" />
            </f:content>
          </f:SimpleForm>
        </Panel>

        <!-- Reference layers -->
        <Panel headerText="{i18n>gis.referenceLayersHeader}" expandable="true" expanded="true" class="sapUiSmallMarginBottom">
          <f:SimpleForm layout="ColumnLayout" columnsM="1" columnsL="2" editable="true">
            <f:content>
              <Label text="{i18n>gis.showStateBoundaries}" />
              <Switch id="swStateBoundaries" state="{config>/showStateBoundaries}" />
              <Label text="{i18n>gis.showLgaBoundaries}" />
              <Switch id="swLgaBoundaries" state="{config>/showLgaBoundaries}" />
            </f:content>
          </f:SimpleForm>
        </Panel>

        <!-- Advanced features -->
        <Panel headerText="{i18n>gis.advancedHeader}" expandable="true" expanded="true" class="sapUiSmallMarginBottom">
          <f:SimpleForm layout="ColumnLayout" columnsM="1" columnsL="2" editable="true">
            <f:content>
              <Label text="{i18n>gis.scaleBar}" />
              <Switch id="swScaleBar" state="{config>/enableScaleBar}" />
              <Label text="{i18n>gis.gps}" />
              <Switch id="swGps" state="{config>/enableGps}" />
              <Label text="{i18n>gis.minimap}" />
              <Switch id="swMinimap" state="{config>/enableMinimap}" />
              <Label text="{i18n>gis.heatmap}" />
              <Switch id="swHeatmap" state="{config>/enableHeatmap}" />
              <Label text="{i18n>gis.timeSlider}" />
              <Switch id="swTimeSlider" state="{config>/enableTimeSlider}" />
              <Label text="{i18n>gis.statsPanel}" />
              <Switch id="swStatsPanel" state="{config>/enableStatsPanel}" />
              <Label text="{i18n>gis.proximity}" />
              <Switch id="swProximity" state="{config>/enableProximity}" />
              <Label text="{i18n>gis.mgaCoords}" />
              <Switch id="swMgaCoords" state="{config>/enableMgaCoords}" />
              <Label text="{i18n>gis.streetView}" />
              <Switch id="swStreetView" state="{config>/enableStreetView}" />
              <Label text="{i18n>gis.conditionAlerts}" />
              <Switch id="swConditionAlerts" state="{config>/enableConditionAlerts}" />
              <Label text="{i18n>gis.customWms}" />
              <Switch id="swCustomWms" state="{config>/enableCustomWms}" />
              <Label text="{i18n>gis.serverClustering}" />
              <Switch id="swServerClustering" state="{config>/enableServerClustering}" />
            </f:content>
          </f:SimpleForm>
        </Panel>

        <!-- Thresholds -->
        <Panel headerText="{i18n>gis.thresholdsHeader}" expandable="true" expanded="false" class="sapUiSmallMarginBottom">
          <f:SimpleForm layout="ColumnLayout" columnsM="1" columnsL="2" editable="true">
            <f:content>
              <Label text="{i18n>gis.conditionAlertThreshold}" />
              <StepInput id="siConditionAlert" value="{config>/conditionAlertThreshold}" min="1" max="10" step="1" />
              <Label text="{i18n>gis.proximityRadius}" />
              <StepInput id="siProximityRadius" value="{config>/proximityDefaultRadiusKm}" min="1" max="500" step="5" />
              <Label text="{i18n>gis.heatmapRadius}" />
              <StepInput id="siHeatmapRadius" value="{config>/heatmapRadius}" min="5" max="80" step="5" />
              <Label text="{i18n>gis.heatmapBlur}" />
              <StepInput id="siHeatmapBlur" value="{config>/heatmapBlur}" min="5" max="50" step="5" />
              <Label text="{i18n>gis.viewportZoom}" />
              <StepInput id="siViewportZoom" value="{config>/viewportLoadingZoom}" min="6" max="14" step="1" />
            </f:content>
          </f:SimpleForm>
        </Panel>

        <!-- Reference Layer Library -->
        <Panel expandable="true" expanded="true" class="sapUiSmallMarginBottom">
          <headerToolbar>
            <OverflowToolbar>
              <Title text="{i18n>gis.refLayerLibrary}" level="H4" />
              <ToolbarSpacer />
              <Button icon="sap-icon://add" text="{i18n>gis.addCustomLayer}" press=".onAddRefLayer" type="Default" />
            </OverflowToolbar>
          </headerToolbar>
          <VBox class="sapUiSmallMargin">
            <Text text="{i18n>gis.refLayerHint}" class="sapUiSmallMarginBottom" wrapping="true" />
            <Table id="tblRefLayers" items="{refLayers>/layers}" noDataText="{i18n>gis.noRefLayers}" growing="true" growingThreshold="20">
              <columns>
                <Column width="3rem" hAlign="Center"><Text text="{i18n>gis.col.on}"/></Column>
                <Column width="8rem"><Text text="{i18n>gis.col.category}"/></Column>
                <Column><Text text="{i18n>gis.col.name}"/></Column>
                <Column width="4rem"><Text text="{i18n>gis.col.type}"/></Column>
                <Column><Text text="{i18n>gis.col.description}"/></Column>
                <Column width="5rem" hAlign="Center"><Text text="{i18n>gis.col.defaultOn}"/></Column>
                <Column width="6rem" hAlign="Center"><Text text="{i18n>gis.col.actions}"/></Column>
              </columns>
              <items>
                <ColumnListItem>
                  <cells>
                    <Switch state="{refLayers>active}" change=".onToggleRefLayerActive" />
                    <ObjectStatus text="{refLayers>category}" state="{= ${refLayers>category} === 'Weather' ? 'Information' : ${refLayers>category} === 'Flood' ? 'Warning' : ${refLayers>category} === 'Emergency' ? 'Error' : 'None' }" />
                    <VBox>
                      <Text text="{refLayers>name}" />
                      <Text text="{refLayers>url}" class="sapUiTinyMarginTop" wrapping="false" maxLines="1" />
                    </VBox>
                    <Text text="{refLayers>layerType}" />
                    <Text text="{refLayers>description}" maxLines="2" wrapping="true" />
                    <Switch state="{refLayers>enabledByDefault}" change=".onToggleRefLayerDefault" />
                    <HBox>
                      <Button icon="sap-icon://edit" type="Transparent" tooltip="{i18n>gis.editLayer}" press=".onEditRefLayer" visible="{= !${refLayers>isPreset} }" />
                      <Button icon="sap-icon://locked" type="Transparent" tooltip="{i18n>gis.presetCannotDelete}" visible="{refLayers>isPreset}" enabled="false" />
                      <Button icon="sap-icon://delete" type="Transparent" tooltip="{i18n>gis.deleteLayer}" press=".onDeleteRefLayer" visible="{= !${refLayers>isPreset} }" />
                    </HBox>
                  </cells>
                </ColumnListItem>
              </items>
            </Table>
          </VBox>
        </Panel>

        <!-- Custom WMS layers -->
        <Panel headerText="{i18n>gis.customWmsHeader}" expandable="true" expanded="false"
               visible="{config>/enableCustomWms}" class="sapUiSmallMarginBottom">
          <headerToolbar>
            <Toolbar>
              <Title text="{i18n>gis.wmsLayerList}" level="H4" />
              <ToolbarSpacer />
              <Button icon="sap-icon://add" text="{i18n>gis.addLayer}" press=".onAddCustomWms" />
            </Toolbar>
          </headerToolbar>
          <content>
            <Text text="{i18n>gis.customWmsHint}" class="sapUiSmallMargin" />
            <Table id="tblCustomWms" items="{config>/customWmsLayers}" noDataText="{i18n>gis.noCustomWms}">
              <columns>
                <Column><Text text="{i18n>gis.col.layerName}" /></Column>
                <Column><Text text="{i18n>gis.col.wmsUrl}" /></Column>
                <Column><Text text="{i18n>gis.col.layerNames}" /></Column>
                <Column width="4rem" hAlign="Center"><Text text="{i18n>gis.col.del}" /></Column>
              </columns>
              <items>
                <ColumnListItem>
                  <cells>
                    <Input value="{config>label}" placeholder="{i18n>gis.wmsDisplayNamePlaceholder}" />
                    <Input value="{config>url}" placeholder="https://..." />
                    <Input value="{config>layers}" placeholder="{i18n>gis.wmsLayersPlaceholder}" />
                    <Button icon="sap-icon://delete" type="Transparent" tooltip="{i18n>gis.deleteLayer}" press=".onDeleteCustomWms" />
                  </cells>
                </ColumnListItem>
              </items>
            </Table>
          </content>
        </Panel>

      </VBox>
    </content>

  </Page>

</mvc:View>
