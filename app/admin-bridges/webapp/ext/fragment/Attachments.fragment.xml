<core:FragmentDefinition
  xmlns="sap.m"
  xmlns:core="sap.ui.core"
  xmlns:unified="sap.ui.unified"
  core:require="{Attachments: 'BridgeManagement/adminbridges/ext/controller/Attachments'}">
  <VBox
    id="attachmentsHost"
    busy="{attachments>/busy}"
    modelContextChange="Attachments.onContextChange"
    class="sapUiSmallMargin">
    <OverflowToolbar>
      <Title text="{i18n>attachmentsTitle}" level="H3"/>
      <ToolbarSpacer/>
      <Button
        icon="sap-icon://refresh"
        type="Transparent"
        tooltip="{i18n>attachmentsRefresh}"
        press="Attachments.onRefresh"/>
      <unified:FileUploader
        id="bridgeAttachmentUploader"
        buttonOnly="true"
        buttonText="{i18n>attachmentsUpload}"
        tooltip="{i18n>attachmentsUpload}"
        icon="sap-icon://upload"
        sameFilenameAllowed="true"
        change="Attachments.onFileChange"/>
    </OverflowToolbar>
    <Table
      id="bridgeAttachmentsTable"
      items="{attachments>/items}"
      noDataText="{i18n>attachmentsNoData}"
      growing="true"
      growingThreshold="20">
      <columns>
        <Column>
          <Text text="{i18n>attachmentsColFileName}"/>
        </Column>
        <Column width="12rem">
          <Text text="{i18n>attachmentsColType}"/>
        </Column>
        <Column width="8rem" hAlign="End">
          <Text text="{i18n>attachmentsColSize}"/>
        </Column>
        <Column width="12rem">
          <Text text="{i18n>attachmentsColUploaded}"/>
        </Column>
        <Column width="8rem" hAlign="End">
          <Text text="{i18n>attachmentsColActions}"/>
        </Column>
      </columns>
      <items>
        <ColumnListItem>
          <cells>
            <ObjectIdentifier title="{attachments>fileName}" text="{attachments>title}"/>
            <Text text="{attachments>mediaType}" wrapping="false"/>
            <Text text="{attachments>fileSizeText}" textAlign="End"/>
            <Text text="{attachments>createdAtText}" wrapping="false"/>
            <HBox justifyContent="End">
              <Button
                icon="sap-icon://display"
                type="Transparent"
                tooltip="{i18n>attachmentsOpen}"
                press="Attachments.onOpen"/>
              <Button
                icon="sap-icon://download"
                type="Transparent"
                tooltip="{i18n>attachmentsDownload}"
                press="Attachments.onDownload"/>
              <Button
                icon="sap-icon://delete"
                type="Transparent"
                tooltip="{i18n>attachmentsDelete}"
                press="Attachments.onDelete"/>
            </HBox>
          </cells>
        </ColumnListItem>
      </items>
    </Table>
  </VBox>
</core:FragmentDefinition>
