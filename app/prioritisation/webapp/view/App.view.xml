<mvc:View
  controllerName="BridgeManagement.prioritisation.controller.App"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:l="sap.ui.layout"
  xmlns:core="sap.ui.core"
  displayBlock="true">
  <App id="rootApp">
    <Page id="mainPage" title="{i18n>appTitle}" showHeader="true">
      <headerContent>
        <Button id="btnHelp" icon="sap-icon://sys-help" text="{i18n>help.button}" type="Transparent" press=".onShowHelp" />
      </headerContent>
      <content>
        <IconTabBar id="tabs" expandable="false" select=".onTabSelect" class="sapUiResponsiveContentPadding">
          <items>
            <!-- ══════════ WORKLIST ══════════ -->
            <IconTabFilter id="tabWorklist" text="{i18n>tab.worklist}" key="worklist" icon="sap-icon://list">
              <MessageStrip text="{i18n>worklist.subtitle}" showIcon="true" class="sapUiTinyMarginBottom" />
              <MessageStrip text="{wl>/error}" type="Error" showIcon="true" visible="{= !!${wl>/error} }" class="sapUiTinyMarginBottom" />
              <!-- B3a: default = current runs (review-held runs excluded server-side); the
                   'Pending review' segment surfaces the held runs via an explicit filter -->
              <SegmentedButton id="wlSegment" selectedKey="{wl>/segment}" selectionChange=".onWorklistSegment" tooltip="{i18n>worklist.subtitle}" class="sapUiTinyMarginBottom">
                <items>
                  <SegmentedButtonItem key="current" text="{i18n>worklist.segCurrent}" />
                  <SegmentedButtonItem key="pending" text="{i18n>worklist.segPending}" />
                </items>
              </SegmentedButton>
              <MessageStrip text="{i18n>worklist.pendingHint}" type="Warning" showIcon="true"
                            visible="{= ${wl>/segment} === 'pending' }" class="sapUiTinyMarginBottom" />
              <Table id="wlTable" items="{path:'wl>/rows'}" growing="true" growingThreshold="50" noDataText="{i18n>worklist.noData}"
                     mode="SingleSelectMaster" itemPress=".onWorklistPress">
                <columns>
                  <Column width="9rem"><Text text="{i18n>worklist.col.band}" /></Column>
                  <Column><Text text="{i18n>worklist.col.bridge}" /></Column>
                  <Column hAlign="End" width="6rem"><Text text="{i18n>worklist.col.score}" /></Column>
                  <Column hAlign="End" width="10rem"><Text text="{i18n>worklist.col.confidence}" /></Column>
                  <Column hAlign="End" width="9rem"><Text text="{i18n>worklist.col.assessed}" /></Column>
                  <Column hAlign="End" width="9rem"><Text text="Detail" /></Column>
                </columns>
                <items>
                  <ColumnListItem type="Active">
                    <cells>
                      <!-- band carries LABEL + NUMBER + semantic state (never colour-only);
                           fleet batch runs are badged "data-only" (council B4: UI honesty) -->
                      <HBox alignItems="Center">
                        <ObjectStatus text="{wl>band}" state="{wl>bandState}" inverted="true" />
                        <ObjectStatus text="{i18n>worklist.dataOnly}" state="Information"
                                      visible="{= ${wl>runType} === 'fleet' }"
                                      tooltip="{i18n>worklist.dataOnlyTooltip}" class="sapUiTinyMarginBegin" />
                        <!-- B3a: held runs are badged loudly — they do not count in summaries/PDF until released -->
                        <ObjectStatus text="{i18n>worklist.pendingBadge}" state="Warning"
                                      visible="{= ${wl>reviewStatus} === 'pending' }"
                                      tooltip="{i18n>worklist.pendingTooltip}" class="sapUiTinyMarginBegin" />
                      </HBox>
                      <ObjectIdentifier title="{wl>bridgeName}" text="{wl>bridgeRef}" />
                      <ObjectNumber number="{wl>priorityScore}" />
                      <Text text="{wl>confidence}" />
                      <Text text="{wl>assessedAtText}" />
                      <HBox justifyContent="End">
                        <Button icon="sap-icon://detail-view" type="Transparent" press=".onOpenRun" tooltip="Open this run's frozen inputs + methodology (audit)" />
                        <!-- B3a: release the hold (manage scope; server-enforced + ChangeLogged) -->
                        <Button icon="sap-icon://accept" type="Transparent" press=".onReleaseRun"
                                visible="{= ${wl>reviewStatus} === 'pending' }"
                                tooltip="{i18n>worklist.releaseTooltip}" text="{i18n>worklist.release}" />
                      </HBox>
                    </cells>
                  </ColumnListItem>
                </items>
              </Table>
            </IconTabFilter>

            <!-- ══════════ ASSESS (hero) ══════════ -->
            <IconTabFilter id="tabAssess" text="{i18n>tab.assess}" key="assess" icon="sap-icon://measure">
              <VBox class="sapUiSmallMarginBeginEnd">
                <HBox alignItems="Center" wrap="Wrap" class="sapUiTinyMarginBottom">
                  <Label text="{i18n>assess.pickBridge}" labelFor="bridgePicker" class="sapUiTinyMarginEnd" />
                  <ComboBox id="bridgePicker" width="22rem" selectionChange=".onPickBridge"
                            items="{path:'br>/rows', templateShareable:false}">
                    <core:Item key="{br>ID}" text="{br>bridgeName} ({br>bridgeId})" />
                  </ComboBox>
                  <ObjectStatus class="sapUiSmallMarginBegin" icon="sap-icon://alert"
                                text="{v>/confidenceText}" state="{v>/confidenceState}" visible="{= !!${v>/bridgeID} }" />
                </HBox>

                <!-- RULE ENGINE: governing model + read-only auto-bound criteria with provenance -->
                <Panel headerText="Configured model: {v>/modelText} — auto criteria (read-only, from data)"
                       visible="{= !!${v>/modelText} &amp;&amp; ${v>/autoCriteria}.length > 0 }" expandable="true" expanded="false" class="sapUiTinyMarginBottom">
                  <Table items="{path:'v>/autoCriteria', templateShareable:false}" >
                    <columns>
                      <Column><Text text="Criterion" /></Column>
                      <Column><Text text="Raw value" /></Column>
                      <Column><Text text="Source (provenance)" /></Column>
                      <Column hAlign="End" width="9rem"><Text text="Score (0–100)" /></Column>
                      <Column hAlign="End" width="6rem"><Text text="Weight" /></Column>
                    </columns>
                    <items><ColumnListItem>
                      <cells>
                        <Text text="{v>code}" /><Text text="{v>rawText}" /><Text text="{v>source}" />
                        <Text text="{v>scoreText}" /><Text text="{v>weight}" />
                      </cells>
                    </ColumnListItem></items>
                  </Table>
                </Panel>

                <!-- federated read-only facts with provenance -->
                <Panel headerText="Federated facts (read-only · from register / EAM / restrictions)" visible="{= !!${v>/bridgeID} }" class="sapUiTinyMarginBottom">
                  <l:Grid defaultSpan="L3 M6 S12" hSpacing="1" vSpacing="0">
                    <VBox><Label text="Condition (EAM)" /><Text text="{v>/facts/conditionText}" /></VBox>
                    <VBox><Label text="Load rating" /><Text text="{v>/facts/loadText}" /></VBox>
                    <VBox><Label text="Active restriction (BIS)" /><Text text="{v>/facts/restrictionSummary}" /></VBox>
                    <VBox><Label text="Register risk (BIS)" /><Text text="{v>/facts/riskText}" /></VBox>
                  </l:Grid>
                </Panel>

                <l:Grid defaultSpan="L6 M12 S12" hSpacing="2" vSpacing="0">
                  <!-- LEFT: dimensions + likelihood -->
                  <VBox>
                    <Title text="{i18n>assess.consequence}" level="H5" class="sapUiTinyMarginBottom" />
                    <VBox id="dimsBox" />
                    <HBox alignItems="Baseline" class="sapUiSmallMarginTop" >
                      <Text text="{i18n>assess.criticality}: " />
                      <ObjectNumber number="{v>/criticality}" emphasized="true" class="sapUiTinyMarginBegin" />
                      <Text text="(tier {v>/tier})" class="sapUiTinyMarginBegin" />
                    </HBox>
                    <Title text="{i18n>assess.likelihood}" level="H5" class="sapUiSmallMarginTop sapUiTinyMarginBottom" />
                    <HBox id="likBox" />
                    <Text text="{i18n>assess.likelihoodHint}" class="sapUiTinyMarginTop" />
                    <Input id="overrideReason" placeholder="{i18n>assess.overrideReason}" value="{v>/likelihoodOverrideReason}"
                           visible="{v>/likelihoodOverridden}" class="sapUiTinyMarginTop" />
                  </VBox>
                  <!-- RIGHT: constrained risk matrix -->
                  <VBox>
                    <Title text="{i18n>assess.matrix}" level="H5" class="sapUiTinyMarginBottom" />
                    <HBox id="matrixBox" />
                    <Text text="{i18n>assess.matrixHint}" class="sapUiTinyMarginTop" />
                  </VBox>
                </l:Grid>

                <!-- score + band + decomposition + formula -->
                <Panel class="sapUiSmallMarginTop">
                  <HBox alignItems="Center" wrap="Wrap">
                    <Label text="{i18n>assess.strategy}" labelFor="strategySelect" class="sapUiTinyMarginEnd" />
                    <Select id="strategySelect" selectedKey="{v>/strategy}" change=".onChange">
                      <core:Item key="Renew" text="Renew" />
                      <core:Item key="Maintain" text="Maintain" />
                      <core:Item key="Monitor" text="Monitor" />
                      <core:Item key="Decommission" text="Decommission" />
                    </Select>
                    <ToolbarSpacer />
                    <Label text="{i18n>assess.priority}" class="sapUiTinyMarginEnd" />
                    <ObjectNumber number="{v>/priorityScore}" emphasized="true" class="sapUiSmallMarginEnd" />
                    <ObjectStatus text="{v>/band}" state="{v>/bandState}" inverted="true" />
                    <Button text="{i18n>assess.save}" type="Emphasized" icon="sap-icon://save" press=".onSave"
                            enabled="{= !!${v>/bridgeID} }" class="sapUiMediumMarginBegin" />
                  </HBox>
                  <VBox id="decompBox" class="sapUiSmallMarginTop" />
                  <Panel headerText="{i18n>assess.formula}" expandable="true" expanded="true" class="sapUiTinyMarginTop">
                    <Text text="{v>/formula}" class="sapUiTinyMargin" />
                  </Panel>
                </Panel>
              </VBox>
            </IconTabFilter>

            <!-- ══════════ REPORTS ══════════ -->
            <IconTabFilter id="tabReports" text="{i18n>tab.reports}" key="reports" icon="sap-icon://bar-chart">
              <SegmentedButton selectedKey="{rep>/mode}" selectionChange=".onReportMode" tooltip="{i18n>tab.reports}" class="sapUiTinyMarginBottom">
                <items>
                  <SegmentedButtonItem key="exec" text="{i18n>reports.exec}" />
                  <SegmentedButtonItem key="eng" text="{i18n>reports.eng}" />
                </items>
              </SegmentedButton>
              <MessageStrip text="{i18n>reports.sameRun}" showIcon="true" class="sapUiTinyMarginBottom" />
              <!-- exec one-pager -->
              <VBox visible="{= ${rep>/mode} === 'exec' }">
                <l:Grid defaultSpan="L3 M6 S12" hSpacing="1" vSpacing="0">
                  <VBox class="sapUiContentPadding"><Text text="Top-decile cost ({rep>/topDecileN} worst)" /><Title text="{rep>/topDecileCost}" level="H4" /></VBox>
                  <VBox class="sapUiContentPadding"><Text text="{i18n>reports.p1}" /><Title text="{rep>/p1}" level="H4" /></VBox>
                  <VBox class="sapUiContentPadding"><Text text="Assessed (of {rep>/totalBridges})" /><Title text="{rep>/assessed} · {rep>/coveragePct}%" level="H4" /></VBox>
                  <VBox class="sapUiContentPadding"><Text text="{i18n>reports.stale}" /><Title text="{rep>/stale}" level="H4" /></VBox>
                </l:Grid>
                <Title text="{i18n>reports.byBand}" level="H6" class="sapUiSmallMarginTop sapUiTinyMarginBottom" />
                <Table items="{path:'rep>/bands'}" noDataText="{i18n>reports.noData}">
                  <columns><Column><Text text="Band" /></Column><Column hAlign="End"><Text text="Count" /></Column></columns>
                  <items><ColumnListItem>
                    <cells><ObjectStatus text="{rep>code}" state="{rep>state}" inverted="true" /><ObjectNumber number="{rep>count}" /></cells>
                  </ColumnListItem></items>
                </Table>
                <Text text="{rep>/headline}" class="sapUiSmallMarginTop" />
                <Panel headerText="Governance" class="sapUiSmallMarginTop">
                  <l:Grid defaultSpan="L4 M6 S12" hSpacing="1" vSpacing="0">
                    <VBox><Label text="Prepared (as-at)" /><Text text="{rep>/asAt}" /></VBox>
                    <VBox><Label text="Methodology owner" /><Text text="{rep>/methodologyOwner}" /></VBox>
                    <VBox><Label text="Methodology version" /><Text text="{v>/configVersion}" /></VBox>
                  </l:Grid>
                  <Text text="Endorsed by / date: ____________________ — figures reconcile to the immutable stored runs." class="sapUiTinyMarginTop sapUiContentLabelColor" />
                </Panel>
                <Button text="Export PDF" icon="sap-icon://pdf-attachment" press=".onExportPdf" class="sapUiSmallMarginTop" />
              </VBox>
              <!-- engineer detail (from the stored run) -->
              <VBox visible="{= ${rep>/mode} === 'eng' }">
                <Table items="{path:'wl>/rows'}" noDataText="{i18n>reports.noData}" mode="SingleSelectMaster">
                  <columns>
                    <Column><Text text="Bridge" /></Column><Column width="7rem"><Text text="Priority" /></Column>
                    <Column hAlign="End" width="6rem"><Text text="Crit/Tier" /></Column>
                    <Column hAlign="End" width="6rem"><Text text="Residual" /></Column>
                    <Column hAlign="End" width="6rem"><Text text="Score" /></Column>
                    <Column hAlign="End" width="9rem"><Text text="Confidence" /></Column>
                    <Column hAlign="End" width="13rem"><Text text="EAM work request" /></Column>
                  </columns>
                  <items><ColumnListItem>
                    <cells>
                      <ObjectIdentifier title="{wl>bridgeName}" text="{wl>bridgeRef}" />
                      <ObjectStatus text="{wl>band}" state="{wl>bandState}" inverted="true" />
                      <Text text="{wl>critTier}" />
                      <Text text="{wl>residualText}" />
                      <ObjectNumber number="{wl>priorityScore}" />
                      <Text text="{wl>confidence}" />
                      <Button text="Raise to EAM" icon="sap-icon://outbox" press=".onRaiseWorkRequest" type="Transparent"
                              tooltip="Raise an inspection work request to SAP EAM (queued; EAM is never modified here)" />
                    </cells>
                  </ColumnListItem></items>
                </Table>
              </VBox>
            </IconTabFilter>

            <!-- ══════════ HEAVY-VEHICLE ASSESSMENT ══════════ -->
            <IconTabFilter id="tabHv" text="{i18n>tab.hv}" key="hv" icon="sap-icon://shipping-status">
              <VBox class="sapUiSmallMargin">
                <MessageStrip text="{i18n>hv.subtitle}" showIcon="true" class="sapUiTinyMarginBottom" />
                <HBox wrap="Wrap" alignItems="End" class="sapUiSmallMarginBottom">
                  <VBox class="sapUiSmallMarginEnd" width="20rem">
                    <Label text="{i18n>hv.bridge}" labelFor="hvBridge" />
                    <ComboBox id="hvBridge" selectedKey="{hv>/bridgeID}" items="{path:'br>/rows'}">
                      <core:Item key="{br>ID}" text="{br>bridgeName} ({br>bridgeId})" />
                    </ComboBox>
                  </VBox>
                  <VBox class="sapUiSmallMarginEnd" width="18rem">
                    <Label text="{i18n>hv.vehicle}" labelFor="hvVehicle" />
                    <ComboBox id="hvVehicle" selectedKey="{hv>/vehicleCode}" items="{path:'hv>/vehicles'}">
                      <core:Item key="{hv>code}" text="{hv>name}" />
                    </ComboBox>
                  </VBox>
                  <Button text="{i18n>hv.assess}" type="Emphasized" icon="sap-icon://begin" press=".onAssessVehicle" class="sapUiSmallMarginEnd" />
                </HBox>
                <ObjectStatus title="{i18n>hv.verdict}" text="{hv>/verdictText}" state="{hv>/verdictState}" class="sapUiSmallMarginBottom" />
                <Text text="{hv>/governing}" class="sapUiTinyMarginBottom" visible="{= !!${hv>/governing} }" />
                <Table items="{path:'hv>/checks'}" noDataText="{i18n>hv.noData}" class="sapUiSmallMarginTop">
                  <columns>
                    <Column><Text text="{i18n>hv.col.check}" /></Column>
                    <Column width="9rem"><Text text="{i18n>hv.col.verdict}" /></Column>
                    <Column><Text text="{i18n>hv.col.detail}" /></Column>
                    <Column hAlign="End" width="7rem"><Text text="{i18n>hv.col.margin}" /></Column>
                  </columns>
                  <items><ColumnListItem>
                    <cells>
                      <Text text="{hv>check}" />
                      <ObjectStatus text="{hv>verdict}" state="{= ${hv>verdict} === 'fail' ? 'Error' : ${hv>verdict} === 'conditional' ? 'Warning' : ${hv>verdict} === 'pass' ? 'Success' : 'None' }" />
                      <Text text="{hv>detail}" />
                      <Text text="{ path: 'hv>marginPct', formatter: '.formatMarginPct' }" />
                    </cells>
                  </ColumnListItem></items>
                </Table>
              </VBox>
            </IconTabFilter>

            <!-- ══════════ CAPITAL PROGRAM ══════════ -->
            <IconTabFilter id="tabCapex" text="{i18n>tab.capex}" key="capex" icon="sap-icon://capital-projects">
              <VBox class="sapUiSmallMargin">
                <MessageStrip text="{i18n>capex.subtitle}" showIcon="true" class="sapUiTinyMarginBottom" />
                <HBox wrap="Wrap" alignItems="End" class="sapUiSmallMarginBottom">
                  <VBox class="sapUiSmallMarginEnd" width="14rem">
                    <Label text="{i18n>capex.budget}" labelFor="capexBudget" />
                    <Input id="capexBudget" value="{capex>/budget}" type="Number" placeholder="e.g. 2000000" />
                  </VBox>
                  <VBox class="sapUiSmallMarginEnd" width="12rem">
                    <Label text="{i18n>capex.strategy}" labelFor="capexStrategy" />
                    <Select id="capexStrategy" selectedKey="{capex>/strategy}">
                      <core:Item key="greedy-bcr" text="{i18n>capex.greedy}" />
                      <core:Item key="knapsack" text="{i18n>capex.knapsack}" />
                    </Select>
                  </VBox>
                  <VBox class="sapUiSmallMarginEnd" width="10rem">
                    <Label text="{i18n>capex.year}" labelFor="capexYear" />
                    <Input id="capexYear" value="{capex>/fundingYear}" placeholder="2026/27" />
                  </VBox>
                  <Button text="{i18n>capex.optimise}" type="Emphasized" icon="sap-icon://sort" press=".onOptimiseCapital" class="sapUiSmallMarginEnd" />
                </HBox>
                <HBox wrap="Wrap" class="sapUiSmallMarginBottom">
                  <ObjectStatus title="{i18n>capex.spent}" text="{capex>/spentText}" state="Information" class="sapUiMediumMarginEnd" />
                  <ObjectStatus title="{i18n>capex.remaining}" text="{capex>/remainingText}" state="Success" class="sapUiMediumMarginEnd" />
                  <ObjectStatus title="{i18n>capex.unfunded}" text="{capex>/unfundedText}" state="{= ${capex>/unfundedCount} > 0 ? 'Error' : 'Success' }" />
                </HBox>
                <MessageStrip text="{capex>/methodSummary}" type="Information" showIcon="true" class="sapUiTinyMarginTop sapUiSmallMarginBottom" visible="{= !!${capex>/methodSummary} }" />
                <Title text="{i18n>capex.funded}" level="H5" class="sapUiTinyMarginTop" />
                <Table items="{path:'capex>/selected'}" noDataText="{capex>/noDataText}">
                  <columns>
                    <Column width="3rem" hAlign="End"><Text text="{i18n>capex.col.rank}" /></Column>
                    <Column><Text text="{i18n>capex.col.name}" /></Column>
                    <Column width="5rem"><Text text="{i18n>capex.col.band}" /></Column>
                    <Column hAlign="End" width="9rem"><Text text="{i18n>capex.col.cost}" /></Column>
                    <Column hAlign="End" width="8rem"><Text text="{i18n>capex.col.perDollar}" /></Column>
                    <Column hAlign="End" width="10rem" minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>capex.col.cumulative}" /></Column>
                    <Column minScreenWidth="Desktop" demandPopin="true"><Text text="{i18n>capex.col.why}" /></Column>
                  </columns>
                  <items><ColumnListItem>
                    <cells>
                      <Text text="{capex>rank}" />
                      <Text text="{capex>name}" />
                      <ObjectStatus text="{capex>band}" state="{= ${capex>band} === 'P1' ? 'Error' : ${capex>band} === 'P2' ? 'Error' : ${capex>band} === 'P3' ? 'Warning' : 'Success' }" />
                      <Text text="{capex>costAud}" />
                      <Text text="{capex>benefitPerDollar}" />
                      <Text text="{capex>cumulativeSpendAud}" />
                      <Text text="{capex>reason}" wrapping="true" />
                    </cells>
                  </ColumnListItem></items>
                </Table>
                <Title text="{i18n>capex.unfundedTitle}" level="H5" class="sapUiSmallMarginTop" visible="{= (${capex>/unfundedDetail} || []).length &gt; 0 }" />
                <Table items="{path:'capex>/unfundedDetail'}" visible="{= (${capex>/unfundedDetail} || []).length &gt; 0 }" noDataText="{i18n>capex.unfundedNone}">
                  <columns>
                    <Column><Text text="{i18n>capex.col.name}" /></Column>
                    <Column width="5rem"><Text text="{i18n>capex.col.band}" /></Column>
                    <Column hAlign="End" width="9rem"><Text text="{i18n>capex.col.cost}" /></Column>
                    <Column hAlign="End" width="9rem"><Text text="{i18n>capex.col.shortBy}" /></Column>
                    <Column minScreenWidth="Desktop" demandPopin="true"><Text text="{i18n>capex.col.whyNot}" /></Column>
                  </columns>
                  <items><ColumnListItem>
                    <cells>
                      <Text text="{capex>name}" />
                      <ObjectStatus text="{capex>band}" state="Error" />
                      <Text text="{capex>costAud}" />
                      <Text text="{capex>shortfallAud}" />
                      <Text text="{capex>reason}" wrapping="true" />
                    </cells>
                  </ColumnListItem></items>
                </Table>
              </VBox>
            </IconTabFilter>
          </items>
        </IconTabBar>
      </content>
    </Page>
  </App>
</mvc:View>
