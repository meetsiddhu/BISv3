{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "_comment": "Mutation testing scoped to the pure-logic engine libs (safety + financial critical) with fast unit tests. Verifies the tests actually detect logic errors — line coverage alone cannot.",
  "testRunner": "jest",
  "jest": { "projectType": "custom", "configFile": "jest.stryker.config.json" },
  "coverageAnalysis": "perTest",
  "mutate": [
    "srv/lib/hv-assessment.js",
    "srv/lib/deterioration.js",
    "srv/lib/capital-optimiser.js",
    "srv/lib/condition-rating.js"
  ],
  "reporters": ["clear-text", "progress"],
  "thresholds": { "high": 80, "low": 60, "break": 50 },
  "concurrency": 4,
  "timeoutMS": 60000
}
